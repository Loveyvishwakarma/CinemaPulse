# ==============================================================================
# CinemaPulse .gitignore
# ==============================================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# ---------- Virtual environments ----------
venv/
.venv/
env/
ENV/

# ---------- Jupyter Notebook ----------
.ipynb_checkpoints/

# ---------- IDE / Editor ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Project-specific ----------
# Trained model artefacts (large binary files)
models/*.pkl
models/*.joblib

# Exported reports (regenerated from code)
reports/figures/*.png
reports/figures/*.jpg
reports/figures/*.svg

# Processed data (regenerated from raw data)
data/processed/*.csv
data/processed/*.parquet

# ---------- DO NOT IGNORE ----------
# Source code, notebooks, raw data, pages, assets — all tracked.
